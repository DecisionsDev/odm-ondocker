<server>
  <!-- decision center datasource -->
  <library id="MySQLLib">
    <fileset dir="${server.config.dir}/resources"/>
  </library>
  
  <jdbcDriver id="MySQLDriver"
  			javax.sql.ConnectionPoolDataSource="com.mysql.cj.jdbc.MysqlConnectionPoolDataSource"
  			javax.sql.DataSource="com.mysql.cj.jdbc.MysqlDataSource"
  			javax.sql.XADataSource="com.mysql.cj.jdbc.MysqlXADataSource"
  			libraryRef="MySQLLib"/>

  <dataSource id="dcdatasource"
			  isolationLevel="TRANSACTION_READ_COMMITTED"
			  jndiName="jdbc/ilogDataSource"
			  statementCacheSize="150"
			  jdbcDriverRef="MySQLDriver"
			  type="javax.sql.ConnectionPoolDataSource">
		<connectionManager
				maxPoolSize="25"
				minPoolSize="10"
				connectionTimout="10s"
				agedTimeout="30m"/>
    <properties databaseName="odmdb"
				user="odmusr"
				password="odmpwd"
				serverName="dbserver" 
				portNumber="DB_PORT_NUMBER"/>
  </dataSource>

</server>
