<server>
  <!-- decision server datasource -->
  <library id="MySQLLib">
    <fileset dir="${server.config.dir}/resources"/>
  </library>
  
   <jdbcDriver id="MySQLDriver"
  			javax.sql.ConnectionPoolDataSource="com.mysql.cj.jdbc.MysqlConnectionPoolDataSource"
  			javax.sql.DataSource="com.mysql.cj.jdbc.MysqlDataSource"
  			javax.sql.XADataSource="com.mysql.cj.jdbc.MysqlXADataSource"
  			libraryRef="MySQLLib"/>

  <dataSource id="resdatasource" jndiName="jdbc/resdatasource" jdbcDriverRef="MySQLDriver" type="javax.sql.ConnectionPoolDataSource">
    <properties 
     databaseName="odmdb"
     user="odmusr"
     password="odmpwd"
     serverName="dbserver"
     portNumber="DB_PORT_NUMBER" />
  </dataSource>

</server>
